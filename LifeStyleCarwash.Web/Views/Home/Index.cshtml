@model LifeStyleCarwash.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Staff Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Login - LifeStyle Carwash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* Geometric Background CSS */
        body {
            background-color: #F0F7FF;
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            position: relative;
        }
        .bg-shape { position: absolute; z-index: -1; }
        .shape-1 { top: 0; right: 0; width: 60vw; height: 60vh; background: #B5D5F0; opacity: 0.6; clip-path: polygon(100% 0, 100% 100%, 0 0); }
        .shape-2 { bottom: 0; left: 0; width: 50vw; height: 50vh; background: #8CBDE2; opacity: 0.3; clip-path: polygon(0 0, 100% 100%, 0 100%); }
        .shape-3 { top: 40%; left: 40%; width: 40vw; height: 40vh; background: #6DAEDB; opacity: 0.2; clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); transform: rotate(45deg); }

        .login-box {
            background-color: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            z-index: 10;
        }
        .icon-container {
            width: 80px; height: 80px; background: #E6F0FA; border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
            margin: 0 auto 20px auto; box-shadow: 0 5px 15px rgba(43, 114, 181, 0.2);
        }
        .car-icon { font-size: 40px; color: #2B72B5; }
        .login-box h2 { color: #08225E; font-weight: 800; margin-bottom: 30px; letter-spacing: 1px; font-size: 24px; }
        .form-control { border-radius: 10px; padding: 12px 15px; margin-bottom: 15px; border: 1px solid #DCE8F3; background-color: #F5F9FD; font-size: 16px; }
        .form-control:focus { border-color: #2B72B5; box-shadow: 0 0 0 0.2rem rgba(43, 114, 181, 0.25); }
        .btn-login { background-color: #2B72B5; color: white; border: none; border-radius: 10px; padding: 12px; width: 100%; font-weight: 700; font-size: 18px; margin-top: 10px; transition: 0.3s; }
        .btn-login:hover { background-color: #1656A0; transform: translateY(-2px); }
        .error-text { color: #dc3545; font-size: 14px; margin-bottom: 15px; background: #ffe6e6; padding: 10px; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
    <div class="bg-shape shape-3"></div>

    <div class="login-box">
        <div class="icon-container">
            <i class="bi bi-car-front-fill car-icon"></i>
        </div>
        <h2>LIFESTYLE SQUARE CARWASH</h2>

        @if (ViewBag.Error != null)
        {
            <div class="error-text">@ViewBag.Error</div>
        }

        <form asp-action="Index" method="post">
            <div class="form-group">
                <input asp-for="Username" class="form-control" placeholder="Username" required />
            </div>
            <div class="form-group">
                <input asp-for="Password" class="form-control" placeholder="Password" required />
            </div>
            <button type="submit" class="btn-login">Login</button>
        </form>
    </div>
</body>
</html>