<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LifeStyle Carwash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>
            <div class="sidebar-logo-text">LifeStyle Square<br>Carwash</div>
        </div>

        <ul class="sidebar-menu">
            <li><a href="/Home/Dashboard"><i class="bi bi-card-checklist"></i> Dashboard</a></li>
            <li><a href="/Home/ManageBooking"><i class="bi bi-calendar-event"></i> Manage Booking</a></li>
            <li><a href="/Home/StaffUpdate"><i class="bi bi-person-badge"></i> Staff Update</a></li>
            <li><a href="/Home/Report"><i class="bi bi-bar-chart-line"></i> Report</a></li>
        </ul>

        <div class="logout-btn">
            <a href="/Home/Logout"><i class="bi bi-box-arrow-right"></i> LOGOUT</a>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>